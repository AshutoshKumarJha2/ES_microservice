{
  "info": {
    "name": "Engagement Manager - Full Test Suite",
    "_postman_id": "engagement-manager-collection-v1",
    "description": "Complete test collection for engagement-manager service.\n\nRUN ORDER:\n1. 00 - Auth Setup (register + login all roles)\n2. 01 - Event Setup (create event, register attendee, approve, check-in)\n3. 02 - Engagement Endpoints\n4. 03 - Feedback Endpoints\n\nAll tokens and IDs are auto-saved via test scripts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "AUTH_URL",       "value": "http://localhost:7070",  "type": "string" },
    { "key": "EVENT_URL",      "value": "http://localhost:7072",  "type": "string" },
    { "key": "ENGAGEMENT_URL", "value": "http://localhost:7071",  "type": "string" },

    { "key": "attendee_token",      "value": "", "type": "string" },
    { "key": "organizer_token",     "value": "", "type": "string" },
    { "key": "admin_token",         "value": "", "type": "string" },

    { "key": "attendee_id",         "value": "", "type": "string" },
    { "key": "organizer_id",        "value": "", "type": "string" },
    { "key": "admin_id",            "value": "", "type": "string" },

    { "key": "event_id",            "value": "", "type": "string" },
    { "key": "registration_id",     "value": "", "type": "string" },
    { "key": "engagement_id",       "value": "", "type": "string" },
    { "key": "feedback_id",         "value": "", "type": "string" }
  ],
  "item": [

    {
      "name": "00 - Auth Setup (auth-manager :7070)",
      "description": "Register and login all three roles. Tokens and user IDs are auto-saved.",
      "item": [

        {
          "name": "Register ATTENDEE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{AUTH_URL}}/api/v1/auth/register", "host": ["{{AUTH_URL}}"], "path": ["api","v1","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Attendee\",\n  \"email\": \"alice.attendee@test.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"ATTENDEE\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 || pm.response.code === 200) {",
                "    const body = pm.response.json();",
                "    if (body.userId) pm.collectionVariables.set('attendee_id', body.userId);",
                "    console.log('ATTENDEE registered. ID:', body.userId);",
                "}"
              ]
            }
          }]
        },

        {
          "name": "Register ORGANIZER",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{AUTH_URL}}/api/v1/auth/register", "host": ["{{AUTH_URL}}"], "path": ["api","v1","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Bob\",\n  \"lastName\": \"Organizer\",\n  \"email\": \"bob.organizer@test.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"ORGANIZER\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 || pm.response.code === 200) {",
                "    const body = pm.response.json();",
                "    if (body.userId) pm.collectionVariables.set('organizer_id', body.userId);",
                "    console.log('ORGANIZER registered. ID:', body.userId);",
                "}"
              ]
            }
          }]
        },

        {
          "name": "Register ADMIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{AUTH_URL}}/api/v1/auth/register", "host": ["{{AUTH_URL}}"], "path": ["api","v1","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Carol\",\n  \"lastName\": \"Admin\",\n  \"email\": \"carol.admin@test.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"ADMIN\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 || pm.response.code === 200) {",
                "    const body = pm.response.json();",
                "    if (body.userId) pm.collectionVariables.set('admin_id', body.userId);",
                "    console.log('ADMIN registered. ID:', body.userId);",
                "}"
              ]
            }
          }]
        },

        {
          "name": "Login as ATTENDEE",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{AUTH_URL}}/api/v1/auth/login", "host": ["{{AUTH_URL}}"], "path": ["api","v1","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice.attendee@test.com\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login successful', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.collectionVariables.set('attendee_token', body.accessToken);",
                "console.log('ATTENDEE token saved.');"
              ]
            }
          }]
        },

        {
          "name": "Login as ORGANIZER",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{AUTH_URL}}/api/v1/auth/login", "host": ["{{AUTH_URL}}"], "path": ["api","v1","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob.organizer@test.com\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login successful', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.collectionVariables.set('organizer_token', body.accessToken);",
                "console.log('ORGANIZER token saved.');"
              ]
            }
          }]
        },

        {
          "name": "Login as ADMIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{AUTH_URL}}/api/v1/auth/login", "host": ["{{AUTH_URL}}"], "path": ["api","v1","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carol.admin@test.com\",\n  \"password\": \"Password@123\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Login successful', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.collectionVariables.set('admin_token', body.accessToken);",
                "console.log('ADMIN token saved.');"
              ]
            }
          }]
        },

        {
          "name": "Validate Token (sanity check)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendee_token}}" }],
            "url": { "raw": "{{AUTH_URL}}/api/v1/auth/validate", "host": ["{{AUTH_URL}}"], "path": ["api","v1","auth","validate"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Token is valid', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "console.log('Validated userId:', body.userId, '| role:', body.userRole);"
              ]
            }
          }]
        }

      ]
    },

    {
      "name": "01 - Event Setup (event-manager :7072)",
      "description": "Create an event, register the attendee, approve registration, then check in. These steps are required before submitting feedback (FeedbackService validates registration status).",
      "item": [

        {
          "name": "Create Event (as ORGANIZER)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizer_token}}" }
            ],
            "url": { "raw": "{{EVENT_URL}}/api/v1/events", "host": ["{{EVENT_URL}}"], "path": ["api","v1","events"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventName\": \"Tech Conference 2026\",\n  \"description\": \"Annual technology conference\",\n  \"startAt\": \"2026-04-10T09:00:00\",\n  \"endAt\": \"2026-04-10T18:00:00\",\n  \"venueId\": \"00000000-0000-0000-0000-000000000001\",\n  \"status\": \"PUBLISHED\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Event created', () => pm.response.to.have.status(201));",
                "const body = pm.response.json();",
                "const id = body.id || body.eventId;",
                "pm.collectionVariables.set('event_id', id);",
                "console.log('Event ID saved:', id);"
              ]
            }
          }]
        },

        {
          "name": "Register ATTENDEE for Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendee_token}}" }
            ],
            "url": { "raw": "{{EVENT_URL}}/api/v1/events/{{event_id}}/registrations", "host": ["{{EVENT_URL}}"], "path": ["api","v1","events","{{event_id}}","registrations"] },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Registration submitted', () => [200, 201].includes(pm.response.code));",
                "const body = pm.response.json();",
                "const regId = body.registrationId || body.id;",
                "if (regId) pm.collectionVariables.set('registration_id', regId);",
                "console.log('Registration ID saved:', regId);"
              ]
            }
          }]
        },

        {
          "name": "Approve Registration (as ORGANIZER)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizer_token}}" }],
            "url": { "raw": "{{EVENT_URL}}/api/v1/registrations/{{registration_id}}/approve", "host": ["{{EVENT_URL}}"], "path": ["api","v1","registrations","{{registration_id}}","approve"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Registration approved', () => pm.response.to.have.status(200));",
                "console.log('Registration approved — status is now CONFIRMED.');"
              ]
            }
          }]
        },

        {
          "name": "Check-In ATTENDEE",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendee_token}}" }],
            "url": { "raw": "{{EVENT_URL}}/api/v1/registrations/{{registration_id}}/check-in", "host": ["{{EVENT_URL}}"], "path": ["api","v1","registrations","{{registration_id}}","check-in"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Check-in successful', () => pm.response.to.have.status(200));",
                "console.log('Attendee checked in — status is now CHECKED_IN.');"
              ]
            }
          }]
        },

        {
          "name": "Get My Registration (verify status)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendee_token}}" }],
            "url": { "raw": "{{EVENT_URL}}/api/v1/events/{{event_id}}/my-registration", "host": ["{{EVENT_URL}}"], "path": ["api","v1","events","{{event_id}}","my-registration"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('My registration retrieved', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "console.log('Registration status:', body.status);"
              ]
            }
          }]
        }

      ]
    },

    {
      "name": "02 - Engagement Endpoints (:7071)",
      "description": "All engagement endpoints. Run after 00 and 01 setup folders.",
      "item": [

        {
          "name": "POST /engagements/log — Record Engagement (ATTENDEE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendee_token}}" }
            ],
            "url": { "raw": "{{ENGAGEMENT_URL}}/engagements/log", "host": ["{{ENGAGEMENT_URL}}"], "path": ["engagements","log"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{event_id}}\",\n  \"attendeeId\": \"{{attendee_id}}\",\n  \"activity\": \"CHECK_IN\",\n  \"activityTimestamp\": \"2026-04-10T09:15:00\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Engagement recorded - 201', () => pm.response.to.have.status(201));",
                "const body = pm.response.json();",
                "pm.collectionVariables.set('engagement_id', body.engagementId);",
                "console.log('Engagement ID saved:', body.engagementId);",
                "pm.test('activityTimestamp is present', () => pm.expect(body.activityTimestamp).to.not.be.null);"
              ]
            }
          }]
        },

        {
          "name": "POST /engagements/log — SESSION_JOIN (ATTENDEE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendee_token}}" }
            ],
            "url": { "raw": "{{ENGAGEMENT_URL}}/engagements/log", "host": ["{{ENGAGEMENT_URL}}"], "path": ["engagements","log"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{event_id}}\",\n  \"attendeeId\": \"{{attendee_id}}\",\n  \"activity\": \"SESSION_JOIN\",\n  \"activityTimestamp\": \"2026-04-10T10:00:00\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Engagement recorded - 201', () => pm.response.to.have.status(201));"
              ]
            }
          }]
        },

        {
          "name": "POST /engagements/log — Future Timestamp (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendee_token}}" }

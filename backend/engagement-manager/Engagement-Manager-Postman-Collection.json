            "url": { "raw": "{{ENGAGEMENT_URL}}/engagements/log", "host": ["{{ENGAGEMENT_URL}}"], "path": ["engagements","log"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{event_id}}\",\n  \"attendeeId\": \"{{attendee_id}}\",\n  \"activity\": \"POLL_VOTE\",\n  \"activityTimestamp\": \"2099-01-01T00:00:00\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Future timestamp rejected - 400', () => pm.response.to.have.status(400));"
              ]
            }
          }]
        },

        {
          "name": "POST /engagements/log — ORGANIZER role (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizer_token}}" }
            ],
            "url": { "raw": "{{ENGAGEMENT_URL}}/engagements/log", "host": ["{{ENGAGEMENT_URL}}"], "path": ["engagements","log"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{event_id}}\",\n  \"attendeeId\": \"{{attendee_id}}\",\n  \"activity\": \"CHAT_MESSAGE\",\n  \"activityTimestamp\": \"2026-04-10T09:30:00\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('ORGANIZER blocked from logging engagement - 403', () => pm.response.to.have.status(403));"
              ]
            }
          }]
        },

        {
          "name": "GET /engagements/event/{eventId}/log — By Event (ATTENDEE)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendee_token}}" }],
            "url": { "raw": "{{ENGAGEMENT_URL}}/engagements/event/{{event_id}}/log", "host": ["{{ENGAGEMENT_URL}}"], "path": ["engagements","event","{{event_id}}","log"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Engagements returned - 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('Returns array', () => pm.expect(body).to.be.an('array'));",
                "pm.test('At least one engagement', () => pm.expect(body.length).to.be.greaterThan(0));",
                "console.log('Total engagements for event:', body.length);"
              ]
            }
          }]
        },

        {
          "name": "GET /engagements/event/{eventId}/log — By Event (ORGANIZER)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{organizer_token}}" }],
            "url": { "raw": "{{ENGAGEMENT_URL}}/engagements/event/{{event_id}}/log", "host": ["{{ENGAGEMENT_URL}}"], "path": ["engagements","event","{{event_id}}","log"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('ORGANIZER can view engagements - 200', () => pm.response.to.have.status(200));"
              ]
            }
          }]
        },

        {
          "name": "GET /engagements/event/{eventId}/log — Non-existent Event (expect 404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{ENGAGEMENT_URL}}/engagements/event/00000000-0000-0000-0000-000000000000/log", "host": ["{{ENGAGEMENT_URL}}"], "path": ["engagements","event","00000000-0000-0000-0000-000000000000","log"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [

    {
      "name": "03 - Feedback Endpoints (:7071)",
      "description": "All feedback endpoints. Attendee must be CONFIRMED or CHECKED_IN to submit feedback. Run 01 - Event Setup first.",
      "item": [

        {
          "name": "POST /feedback — Submit Feedback (ATTENDEE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendee_token}}" }
            ],
            "url": { "raw": "{{ENGAGEMENT_URL}}/feedback", "host": ["{{ENGAGEMENT_URL}}"], "path": ["feedback"] },
            "body": {
              "mode": "raw",

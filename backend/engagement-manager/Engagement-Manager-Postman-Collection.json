            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{ENGAGEMENT_URL}}/engagements/activity/CHECK_IN/log", "host": ["{{ENGAGEMENT_URL}}"], "path": ["engagements","activity","CHECK_IN","log"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Engagements by activity - 200', () => pm.response.to.have.status(200));",

          "name": "GET /engagements/activity/{activity}/log — SESSION_JOIN (ATTENDEE)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{attendee_token}}" }],
            "url": { "raw": "{{ENGAGEMENT_URL}}/engagements/activity/SESSION_JOIN/log", "host": ["{{ENGAGEMENT_URL}}"], "path": ["engagements","activity","SESSION_JOIN","log"] }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Engagements by SESSION_JOIN - 200', () => pm.response.to.have.status(200));"
              ]
            }
          }]
        },

        {
